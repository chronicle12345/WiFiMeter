{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WiFiMeter",
  "version": "1.3.1",
  "identifier": "io.wifimeter.demo",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": ["desktop"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../assets/icon.ico", "../assets/icon.png"],
    "resources": { "resources/": "resources/" },
    "linux": {
      "deb": {
        "depends": ["network-manager", "pkexec | policykit-1", "libelf1 | libelf1t64", "libsqlite3-0", "zlib1g", "xdg-utils", "libstdc++6", "libgcc-s1", "libc6 (>= 2.35)"]
      },
      "rpm": {
        "depends": ["NetworkManager", "polkit", "elfutils-libelf", "sqlite-libs", "zlib", "xdg-utils", "libstdc++", "libgcc"],
        "compression": { "type": "xz", "level": 6 }
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": true, "installerHooks": "../../../packaging/tauri/windows/hooks.nsh" }
    }
  }
}
